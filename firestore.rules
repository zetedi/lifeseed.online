rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/config/superadmin) &&
             get(/databases/$(database)/documents/config/superadmin).data.uid == request.auth.uid;
    }
    function isStaff() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || request.auth.token.admin == true || isSuperAdmin();
    }
    // "Owner" means KEEPER: the founding ownerId or any `keeper` link holder — FULL PEERS
    // (ring 2026-08-12, domain/keeperCircle). Keeper links are never client-minted: only the
    // server writes one (acceptKeeperInvite / acceptKeeperRequest), after proving the newcomer
    // owns a living tree. Extending THIS function is what makes peers peers everywhere at once.
    function hasKeeperLink(communityId) {
      return exists(/databases/$(database)/documents/links/$(request.auth.uid + '__keeper__' + communityId));
    }
    function isCommunityOwner(communityId) {
      return communityId is string &&
        (
          (exists(/databases/$(database)/documents/communities/$(communityId)) &&
           get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid)
          || hasKeeperLink(communityId)
        );
    }
    // A keeper of the community's DOOR: its owner, or a linked steward — the delegated hands
    // that accept knocks, remove members, and mint/revoke invitations. Delegation is a link.
    function isCommunityKeeper(communityId) {
      return isCommunityOwner(communityId)
        || (communityId is string
            && exists(/databases/$(database)/documents/links/$(request.auth.uid + '__steward__' + communityId)));
    }
    // The community's door (domain/communityDoor.ts). Absent = 'invite' (the pre-door
    // behaviour: knock + accept). A missing community's door reads as closed — deny.
    function communityDoor(communityId) {
      return (communityId is string
          && exists(/databases/$(database)/documents/communities/$(communityId)))
        ? get(/databases/$(database)/documents/communities/$(communityId)).data.get('door', 'invite')
        : 'closed';
    }
    // A community invitation usable for `communityId` right now: it belongs to that community,
    // is unrevoked and unexpired — and even a valid invitation waits while the door is closed.
    function inviteOpensDoor(inviteId, communityId) {
      return inviteId is string && inviteId != ''
        && exists(/databases/$(database)/documents/communityInvites/$(inviteId))
        && get(/databases/$(database)/documents/communityInvites/$(inviteId)).data.communityId == communityId
        && get(/databases/$(database)/documents/communityInvites/$(inviteId)).data.get('revokedAt', null) == null
        && (get(/databases/$(database)/documents/communityInvites/$(inviteId)).data.get('expiresAt', null) == null
            || get(/databases/$(database)/documents/communityInvites/$(inviteId)).data.expiresAt > request.time)
        && communityDoor(communityId) != 'closed';
    }
    // Visibility enforcement for pulses (events/decisions/reaches/growth). Mirrors the
    // generator in src/domain/pulseVisibility.ts → canView(). Same-document get()s are
    // cached within one request, so a scoped query (one community / one tree) costs one read.
    // True if the signed-in user has a `${uid}__${rel}__${toId}` edge in the links collection.
    function hasLink(rel, toId) {
      return exists(/databases/$(database)/documents/links/$(request.auth.uid + '__' + rel + '__' + toId));
    }
    // Membership is the LIN: a `member` link, or being the community's owner (implicitly inside
    // their own circle). The legacy array branches are gone — links are the single source of truth.
    function isCommunityMember(communityId) {
      return communityId is string && communityId != '' && (
        hasLink('member', communityId)
        || (exists(/databases/$(database)/documents/communities/$(communityId))
            && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == request.auth.uid));
    }
    // A party to a covenant: does the signed-in user hold a `party` link into it? Authority-by-path,
    // exactly like hasLink — the covenant's proposer minted these (domain/covenant.ts).
    function isCovenantParty(covenantId) {
      return covenantId is string && covenantId != '' &&
        exists(/databases/$(database)/documents/links/$(request.auth.uid + '__party__' + covenantId));
    }
    // THE SIGNING EPOCH: a signature counts only while the person's server-anchored CURRENT epoch
    // is active. recordedAt is the Firestore receipt time — never a client-chosen claim. The epoch
    // event and append-only key record must agree with the current person declaration.
    function isCurrentEpochSignature(personId) {
      let person = get(/databases/$(database)/documents/persons/$(personId)).data;
      let epochId = request.resource.data.get('epochId', '');
      let fingerprint = request.resource.data.get('keyFingerprint', '');
      return request.resource.data.get('version', 0) == 3
        && request.resource.data.get('recordedAt', null) == request.time
        && person.get('signingState', '') == 'active'
        && person.get('publicKeyPem', '') == request.resource.data.get('pubkey', '')
        && person.get('signingKeyFingerprint', '') == fingerprint
        && person.get('signingEpochId', '') == epochId
        && exists(/databases/$(database)/documents/persons/$(personId)/keys/$(fingerprint))
        && get(/databases/$(database)/documents/persons/$(personId)/keys/$(fingerprint)).data.get('pubkey', '')
             == request.resource.data.get('pubkey', '')
        && exists(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId))
        && get(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('epochId', '') == epochId
        && get(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('lid', '')
             == person.get('lid', '')
        && get(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('keyFingerprint', '') == fingerprint
        && get(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('recordedAt', request.time) <= request.time;
    }
    function validSigningAnchor(personId) {
      let fingerprint = request.resource.data.get('signingKeyFingerprint', '');
      let epochId = request.resource.data.get('signingEpochId', '');
      return request.resource.data.get('publicKeyPem', '') != ''
        && fingerprint != ''
        && epochId == 'anchor_' + fingerprint
        && request.resource.data.get('signingState', '') == 'active'
        && request.resource.data.get('signingAnchoredAt', null) == request.time
        && existsAfter(/databases/$(database)/documents/persons/$(personId)/keys/$(fingerprint))
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keys/$(fingerprint)).data.get('pubkey', '')
             == request.resource.data.get('publicKeyPem', '')
        && existsAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId))
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('type', '') == 'anchor'
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('uid', '') == personId
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('lid', '')
             == request.resource.data.get('lid', '')
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('epochId', '') == epochId
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('keyFingerprint', '') == fingerprint
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(epochId)).data.get('recordedAt', null) == request.time;
    }
    function validSigningFreeze(personId) {
      let epochId = resource.data.get('signingEpochId', '');
      let eventId = request.resource.data.get('signingFreezeEventId', '');
      return resource.data.get('signingState', '') == 'active'
        && request.resource.data.get('signingState', '') == 'frozen'
        && request.resource.data.get('publicKeyPem', '') == resource.data.get('publicKeyPem', '')
        && request.resource.data.get('signingKeyFingerprint', '') == resource.data.get('signingKeyFingerprint', '')
        && request.resource.data.get('signingEpochId', '') == epochId
        && request.resource.data.get('signingFrozenAt', null) == request.time
        && eventId == 'freeze_' + epochId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['signingState', 'signingFrozenAt', 'signingFreezeEventId'])
        && existsAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(eventId))
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(eventId)).data.get('type', '') == 'freeze'
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(eventId)).data.get('uid', '') == personId
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(eventId)).data.get('epochId', '') == epochId
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(eventId)).data.get('keyFingerprint', '')
             == resource.data.get('signingKeyFingerprint', '')
        && getAfter(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(eventId)).data.get('recordedAt', null) == request.time;
    }
    // Tree roles split by privilege. A `guardian` link is a LIGHTWEIGHT, self-serve public follow
    // (any signed-in user may add one) and grants NO privileges — it is deliberately excluded from
    // every check below. Caring and circle access vest only in the invited roles (co_owner /
    // steward / observer), whose links are minted server-side by acceptTreeInvite (never self-serve).
    function isTreeOwner(treeId) {
      return treeId is string && treeId != '' &&
        exists(/databases/$(database)/documents/lifetrees/$(treeId)) &&
        get(/databases/$(database)/documents/lifetrees/$(treeId)).data.ownerId == request.auth.uid;
    }
    // CARERS may edit a tree and confirm its watering: owner, co_owner, or steward.
    function isTreeCarer(treeId) {
      return treeId is string && treeId != '' && (
        hasLink('co_owner', treeId) || hasLink('steward', treeId) || isTreeOwner(treeId));
    }
    // The CIRCLE may read a tree's private (circle-visibility) pulses: carers plus observers.
    function isTreeCircle(treeId) {
      return treeId is string && treeId != '' && (
        hasLink('co_owner', treeId) || hasLink('steward', treeId)
        || hasLink('observer', treeId) || isTreeOwner(treeId));
    }
    // The credential a peer needs to pass validation on: a lifetree the caller OWNS that is itself
    // validated (the web-of-trust root is a staff/GENESIS-validated tree). Mirrors canValidateTree
    // in src/utils/validation.ts, minus its time-based "live" freshness check (still enforced in the
    // UI/service layer). Blocks self-validation: an unvalidated tree cannot be its own validator.
    function isOwnedValidatedTree(treeId) {
      return treeId is string && treeId != ''
        && exists(/databases/$(database)/documents/lifetrees/$(treeId))
        && get(/databases/$(database)/documents/lifetrees/$(treeId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/lifetrees/$(treeId)).data.get('validated', false) == true;
    }
    // A private direct message / group reach: a 'reach' pulse that names its recipients
    // (participantUids) or a single recipient (legacy recipientUid). Minted, public "reach"
    // reflections have neither and stay world-readable through the normal visibility path.
    function isPrivateReach() {
      return resource.data.get('type', '') == 'reach' && (
             resource.data.get('participantUids', null) != null
             || resource.data.get('recipientUid', null) != null);
    }
    // LIST proves safety from the QUERY'S CONSTRAINTS, never per-document (a list rule
    // cannot filter — it allows or denies the whole query). Default 'unlisted' (NOT the get
    // rule's 'public'): an UNCONSTRAINED list proves no readable level and is refused, so a
    // caller must pin what they may see. THIS closes the leak reported from the other side —
    // an anonymous `type==event` with no visibility filter returned private events in full,
    // because canReadPulse's 'public' default made the unconstrained list provably true.
    // Every branch is satisfiable only when the query pins it: the public feed pins
    // visibility=='public'; the node feed pins visibility in [public,node]; own pulses pin
    // authorId==uid; the inbox pins participantUids array-contains uid; a 1:1 reach pins
    // recipientUid==uid. Staff is a lookup, provable for any query. (After the visibility
    // backfill every pulse carries the field, so visibility-pinned queries drop nothing.)
    function canListPulse() {
      return resource.data.get('visibility', 'unlisted') == 'public'
        || (isSignedIn() && (
             isStaff()
             || resource.data.get('visibility', 'unlisted') == 'node'
             || resource.data.get('authorId', '') == request.auth.uid
             || request.auth.uid in resource.data.get('participantUids', [])
             || resource.data.get('recipientUid', '') == request.auth.uid
             || (resource.data.get('visibility', 'unlisted') == 'community'
                 && isCommunityMember(resource.data.get('communityId', '')))
             || (resource.data.get('visibility', 'unlisted') == 'circle'
                 && (isTreeCircle(resource.data.get('treeId', '')) || isTreeCircle(resource.data.get('lifetreeId', ''))))
           ));
    }
    function canReadPulse() {
      // Private reaches are NEVER public: only the author, the addressed recipient, the
      // people in the thread, and staff may read them — regardless of any visibility field.
      return isPrivateReach()
        ? (isSignedIn() && (
             isStaff()
             || resource.data.authorId == request.auth.uid
             || resource.data.get('recipientUid', '') == request.auth.uid
             || request.auth.uid in resource.data.get('participantUids', [])
           ))
        // Absent visibility = 'public', so every legacy (non-reach) pulse stays readable.
        : (resource.data.get('visibility', 'public') == 'public'
        || (isSignedIn() && (
             isStaff()
             || resource.data.authorId == request.auth.uid
             || resource.data.get('visibility', 'public') == 'node'
             || (resource.data.get('visibility', 'public') == 'community' && isCommunityMember(resource.data.get('communityId', '')))
             || (resource.data.get('visibility', 'public') == 'circle'
                 && (isTreeCircle(resource.data.get('treeId', '')) || isTreeCircle(resource.data.get('lifetreeId', ''))))
           )));
    }

    // Love must never become an existence oracle. Reuse the exact parent visibility gates on
    // the love-update path so knowing a private document id grants no new way to touch it.
    function canReadLifetree() {
      return !('visibility' in resource.data)
        || resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.visibility == 'node')
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || isStaff();
    }
    function canReadVision() {
      return !('visibility' in resource.data)
        || resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.visibility == 'node')
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || isStaff();
    }
    // Lists cannot safely inherit the absent-visibility compatibility branch above: without a
    // query constraint it makes a collection read broad enough to return private visions. A list
    // must prove public/node visibility, authorship, or staff standing. Legacy docs remain
    // directly readable by id and remain listable to their own author.
    function canListVision() {
      return resource.data.get('visibility', 'unlisted') == 'public'
        || (isSignedIn() && (
             resource.data.get('visibility', 'unlisted') == 'node'
             || resource.data.authorId == request.auth.uid
             || isStaff()
           ));
    }
    function canReadLightHouse() {
      return resource.data.get('visibility', 'community') == 'public'
        || (isSignedIn() && (
             resource.data.get('visibility', 'community') == 'node'
             || resource.data.get('ownerId', '') == request.auth.uid
             || isStaff()
             || isCommunityMember(resource.data.get('communityId', ''))
           ));
    }

    // LOVE IS ONE ATOMIC GESTURE: a private loves/{uid} slot and the public tally move
    // together, exactly once, in the same transaction. Field-only gates are insufficient:
    // without the slot transition, any signed-in client could forge an arbitrary tally.
    function validLoveCountChange(collectionName, beingId) {
      let before = resource.data.get('loveCount', 0);
      let after = request.resource.data.get('loveCount', 0);
      let hadLove = exists(/databases/$(database)/documents/$(collectionName)/$(beingId)/loves/$(request.auth.uid));
      let hasLove = existsAfter(/databases/$(database)/documents/$(collectionName)/$(beingId)/loves/$(request.auth.uid));
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['loveCount', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
               .hasAll(['loveCount', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && before is int
        && after is int
        && after >= 0
        && (
          (!hadLove && hasLove && after == before + 1)
          || (hadLove && !hasLove && before > 0 && after == before - 1)
        );
    }

    // Pulses carry the legacy validationScore mirror as well as loveCount. Both must
    // remain equal, and the same private-slot transition proves the +/- one.
    function validPulseLoveCountChange(pulseId) {
      let oldLoveCount = resource.data.get('loveCount', 0);
      let before = oldLoveCount > 0 ? oldLoveCount : resource.data.get('validationScore', 0);
      let after = request.resource.data.get('loveCount', 0);
      let hadLove = exists(/databases/$(database)/documents/pulses/$(pulseId)/loves/$(request.auth.uid));
      let hasLove = existsAfter(/databases/$(database)/documents/pulses/$(pulseId)/loves/$(request.auth.uid));
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['loveCount', 'validationScore', 'updatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys()
               .hasAll(['loveCount', 'validationScore', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && before is int
        && after is int
        && after >= 0
        && request.resource.data.validationScore == after
        && (
          (!hadLove && hasLove && after == before + 1)
          || (hadLove && !hasLove && before > 0 && after == before - 1)
        );
    }

    // The other half of the proof: a love slot cannot be created or removed by itself.
    // Its path is authoritative (loveId == auth uid), its payload is minimal, and the
    // parent tally after the atomic write must show the corresponding transition.
    function validLoveSlotCreate(collectionName, beingId, loveId) {
      let parent = /databases/$(database)/documents/$(collectionName)/$(beingId);
      let before = get(parent).data.get('loveCount', 0);
      return isSignedIn()
        && isOwner(loveId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && before is int
        && getAfter(parent).data.get('loveCount', 0) == before + 1;
    }

    function validLoveSlotDelete(collectionName, beingId, loveId) {
      let parent = /databases/$(database)/documents/$(collectionName)/$(beingId);
      let before = get(parent).data.get('loveCount', 0);
      return isSignedIn()
        && isOwner(loveId)
        && before is int
        && before > 0
        && getAfter(parent).data.get('loveCount', 0) == before - 1;
    }

    function validPulseLoveSlotCreate(pulseId, loveId) {
      let parent = /databases/$(database)/documents/pulses/$(pulseId);
      let oldLoveCount = get(parent).data.get('loveCount', 0);
      let before = oldLoveCount > 0 ? oldLoveCount : get(parent).data.get('validationScore', 0);
      return isSignedIn()
        && isOwner(loveId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && before is int
        && getAfter(parent).data.get('loveCount', 0) == before + 1
        && getAfter(parent).data.get('validationScore', 0) == before + 1;
    }

    function validPulseLoveSlotDelete(pulseId, loveId) {
      let parent = /databases/$(database)/documents/pulses/$(pulseId);
      let oldLoveCount = get(parent).data.get('loveCount', 0);
      let before = oldLoveCount > 0 ? oldLoveCount : get(parent).data.get('validationScore', 0);
      return isSignedIn()
        && isOwner(loveId)
        && before is int
        && before > 0
        && getAfter(parent).data.get('loveCount', 0) == before - 1
        && getAfter(parent).data.get('validationScore', 0) == before - 1;
    }

    // Admins collection: read staff, no direct write
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // A community inviting a lifetree to stand with it. Anyone signed-in may extend an invite
    // (naming themselves as inviter); only the invitee (the tree's owner) settles it. The
    // resulting membership is a 'participant' link, governed by the links rules.
    match /communityTreeInvites/{id} {
      // Read is signed-in-wide: the dupe-check queries by lifetreeId, which per-participant
      // read rules would reject (list rules must hold for every possible result).
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.invitedByUserId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.invitedUserId == request.auth.uid || resource.data.invitedByUserId == request.auth.uid);
      allow delete: if isStaff();
    }

    // Keeper invitations (ring 2026-08-12): a sitting keeper OFFERS shared keepership of a
    // community; the invitee ACCEPTS through the acceptKeeperInvite callable, which proves
    // their own living tree and mints the `keeper` link server-side. The doc is the offer,
    // never the power — and its identity triplet is frozen so an accept mark can never be
    // steered at a different community or hand.
    match /communityKeeperInvites/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.invitedByUserId == request.auth.uid
        && isCommunityOwner(request.resource.data.communityId);
      allow update: if isSignedIn()
        && (resource.data.invitedUserId == request.auth.uid || resource.data.invitedByUserId == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['communityId', 'invitedUserId', 'invitedByUserId']);
      allow delete: if isStaff();
    }

    // Organisation collabs — the node's collaborators (founder-agreed or by contract).
    // World-readable. Any signed-in member may add an org, naming themselves as creator
    // (the app additionally gates the UI to validated/initiated members). The creator may
    // care their own entry's communityId/logoUrl/blurb (field-level diff, like alignments)
    // and remove it; everything else stays staff.
    match /collabs/{id} {
      allow read: if true;
      allow create: if isStaff() || (isSignedIn() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isStaff()
        || (isSignedIn()
            && resource.data.get('createdBy', '') == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['communityId', 'logoUrl', 'blurb']));
      allow delete: if isStaff() || (isSignedIn() && resource.data.get('createdBy', '') == request.auth.uid);
    }

    // The initiated layer — a Firestore MIRROR of the git initiation ledger (initiations/ in the
    // repo, three-sponsor rule enforced in CI). Git is the source of truth; the superadmin syncs
    // records that declare a uid so the rules below can check initiate rights server-side.
    match /initiates/{uid} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Config collection: read staff/config-specific, no direct write.
    // config/limits (the node's planting caps) is world-readable — the client planting gate
    // reads it — and staff-writable from the node admin page.
    // config/dataAuthority is also world-readable: the backend publicly names the portable LID
    // of the node that governs it. It is SERVER-WRITABLE ONLY; no client, including staff, may
    // crown a community by rewriting the custody declaration.
    match /config/{configId} {
      allow read: if configId in ['superadmin', 'limits', 'dataAuthority'] || isStaff();
      allow write: if configId == 'limits' && isStaff();
    }

    // THE LID INDEX — beings/{lid} -> { kind, collection, docId }: a true name written down
    // beside the local address holding it today (ring 2026-08-09, src/domain/beingIndex.ts).
    // WRITE IS SERVER-ONLY, and not merely staff-only: an identity record a client could forge
    // is not an identity record — anyone could claim a lid or re-point someone else's name. The
    // trigger (functions/indexPersonLid …) writes through the admin SDK, which bypasses rules.
    // Read is open because a lid is unguessable and is already the thing a being's QR PUBLISHES;
    // the entry carries no name, no owner and no visibility, and reading the being it points at
    // is still gated by that collection's own rules. Emptying this collection breaks nothing:
    // every being still resolves by the older search.
    // GET, never LIST: the openness argument rests on a lid being unguessable, and an open
    // list query would make every lid enumerable in one sweep — including the addresses of
    // private records. You may ask about a name you hold; you may not harvest the names.
    match /beings/{lid} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }

    // Users collection: Read self/staff, Write self
    // Self-write covers the onlyValidatedCanReach contact-privacy flag. That flag is
    // mirrored onto the user's (world-readable) lifetrees so the reach gate can read it
    // without exposing the rest of the private user doc to other members.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create, delete: if isOwner(userId) || isStaff();
      // `invitesRemaining` is a server-authoritative allowance. From the client a user may only
      // SPEND it (lower it) or hold it within the self-serve allotment (144, granted on community
      // creation) — it can never be inflated past that, closing the "set invitesRemaining:1e6 →
      // unlimited invites" hole. All other profile fields (theme, prefs, privacy flags) stay
      // self-writable. Staff may set any value.
      allow update: if isStaff()
        || (isOwner(userId) && (
             request.resource.data.get('invitesRemaining', 0) <= resource.data.get('invitesRemaining', 0)
             || request.resource.data.get('invitesRemaining', 0) <= 144
           ));
    }

    // Subscriptions: Create public, Read staff
    match /subscriptions/{subId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if isStaff();
    }

    // Mail: read your own / staff. Creation is SERVER-ONLY — every outbound email is composed and
    // queued by Cloud Functions via the Admin SDK (sendSystemEmail / newsletter), which bypass
    // these rules. A direct client write is an open-relay vector, so it is denied.
    match /mail/{mailId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow create: if false;
      allow delete: if isStaff();
    }

    // Usage: per-user server-authoritative daily counters (AI free-tier + outbound email). Written
    // ONLY by Cloud Functions via the Admin SDK; a user may read their own to display allowance.
    match /usage/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if false;
    }

    // Lifetrees: Read public, Write owner/staff
    match /lifetrees/{treeId} {
      // Visibility-gated reads. Missing visibility = public (legacy-safe). 'node' = any signed-in
      // member; 'private' = owner or staff only. (List queries must filter to the same levels.)
      allow read: if canReadLifetree();
      // Planting is open — except a BED (domain/bed.ts), whose home is optional and SOFT:
      // it is born either HOUSED (lightHouseId set — only that Light House's keeper plants
      // one, in their own name) or LOOSE (no lightHouseId — standing at a real coordinate
      // under open stars, planted by its own keeper). A bed with NEITHER a house NOR a place
      // is refused — from EVERY hand: the place gate, like the domain gate, is a DATA-VALIDITY
      // invariant that binds staff too (staff stay exempt only from the ownership check).
      // EVERY bed — housed, loose, staff-planted — is born domainless
      // (domain == '' is the structural forest-exclusion invariant: a domain-scoped query
      // must never surface a bed).
      // THE BIRTH IS SIGNED (ring 2026-08-17): ownerId is the planter's OWN uid, from every
      // hand but staff's (staff stay exempt only from the ownership check, the bed gate's
      // precedent — they plant the node's genesis and beings for others). Before this, any
      // signed-in client could plant a tree wearing any uid it liked.
      allow create: if isSignedIn()
        && (isStaff() || request.resource.data.get('ownerId', '') == request.auth.uid)
        && (
        request.resource.data.get('treeType', '') != 'BED'
        || (
          request.resource.data.get('domain', '') == ''
          // LOOSE (no house): a REAL place instead (the internet has no weather).
          // On-Earth ranges only: NaN fails every comparison and Infinity fails the
          // range, so a bed can never be born at a non-place. The edges of the map
          // are still places — the poles (±90) and the antimeridian (±180) welcome it.
          // A HOUSED bed needs no coordinate — its place is its house.
          && (
            request.resource.data.get('lightHouseId', '') != ''
            || (
              request.resource.data.get('latitude', '') is number
              && request.resource.data.latitude >= -90
              && request.resource.data.latitude <= 90
              && request.resource.data.get('longitude', '') is number
              && request.resource.data.longitude >= -180
              && request.resource.data.longitude <= 180
            )
          )
          && (
            isStaff()
            || (
              request.resource.data.ownerId == request.auth.uid
              && (
                // HOUSED: the house names its keeper, and the keeper is the writer.
                (
                  request.resource.data.get('lightHouseId', '') != ''
                  && get(/databases/$(database)/documents/lightHouses/$(request.resource.data.lightHouseId)).data.ownerId == request.auth.uid
                )
                // LOOSE: no house — the shared place gate above has already proven the coordinate.
                || request.resource.data.get('lightHouseId', '') == ''
              )
            )
          )
        )
      );
      // Carers (owner/co_owner/steward) or staff may edit a tree — but `validated`/`validatorId`
      // and `ownerId` are FROZEN on the edit path, so a tree can neither self-validate (the flag
      // that bypasses onlyValidatedCanReach) nor transfer its own ownership from the client.
      // `lightHouseId` is SOFT, not frozen (a loose bed may one day graduate or join a house) —
      // but any write that sets or changes it to a non-empty house must come from that house's
      // keeper (a bed never forges into a house it isn't welcome in); clearing it back to ''
      // (going loose) is free — provided the bed then stands at a real place (below).
      //
      // Two DATA-VALIDITY gates stand before every branch and bind EVERY writer, staff
      // included — exactly like the domain gate at birth:
      //   (1) the BED line is uncrossable by edit: treeType may still flip between LIFETREE
      //       and GUARDED (the convert feature), but a bed stays a bed and a tree never
      //       becomes one — else an edit could dodge the keeper-only create gate above,
      //       or surface a bed in the forest as a tree;
      //   (2) a loose bed is a REAL place for its whole LIFE, not only at birth: if the
      //       RESULTING doc is a loose bed (BED, no house), it must carry an on-Earth
      //       coordinate — no edit may strand it at latitude 999, NaN, or nowhere. A housed
      //       bed needs no coordinate, and overlay edits (validation, watering) that leave
      //       a real place untouched pass untroubled.
      allow update: if isSignedIn()
        && (request.resource.data.get('treeType', '') == 'BED')
            == (resource.data.get('treeType', '') == 'BED')
        && (
          request.resource.data.get('treeType', '') != 'BED'
          || request.resource.data.get('lightHouseId', '') != ''
          || (
            request.resource.data.get('latitude', '') is number
            && request.resource.data.latitude >= -90
            && request.resource.data.latitude <= 90
            && request.resource.data.get('longitude', '') is number
            && request.resource.data.longitude >= -180
            && request.resource.data.longitude <= 180
          )
        )
        && (
        (
          (resource.data.ownerId == request.auth.uid || isStaff()
             || hasLink('co_owner', treeId) || hasLink('steward', treeId))
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['validated', 'validatorId', 'ownerId', 'lid', 'loveCount'])
          // ...and a bed never gains or alters a `domain`: the forest-exclusion invariant
          // holds for its whole life, not only at birth.
          && (resource.data.get('treeType', '') != 'BED'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['domain']))
          // Soft containment: pointing at a house requires keeping that house.
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lightHouseId'])
            || request.resource.data.get('lightHouseId', '') == ''
            || get(/databases/$(database)/documents/lightHouses/$(request.resource.data.lightHouseId)).data.ownerId == request.auth.uid
          )
        )
        // Peer validation (web of trust): a validator signs ANOTHER tree with a validated tree it
        // owns. Only the validation fields may change here; self-validation is blocked because an
        // unvalidated tree fails isOwnedValidatedTree.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validated', 'validatorId', 'updatedAt'])
          && request.resource.data.get('validated', false) == true
          && isOwnedValidatedTree(request.resource.data.get('validatorId', ''))
        )
        // Initiate validation: a member of the initiated layer (git ledger, mirrored to
        // /initiates/{uid}) signs in their own name. Same validation-fields-only constraint;
        // validatorId must be the initiate themselves. Validate-on only — dimming stays staff.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['validated', 'validatorId', 'updatedAt'])
          && request.resource.data.get('validated', false) == true
          && request.resource.data.get('validatorId', '') == request.auth.uid
          && exists(/databases/$(database)/documents/initiates/$(request.auth.uid))
        )
        // Staff keep their broad edit powers (dimming validation, repairs) — but the bed's
        // domain-freeze binds even them, exactly as at birth: a bed never carries a domain,
        // at create or edit, staff or not.
        || (
          isStaff()
          && (resource.data.get('treeType', '') != 'BED'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['domain']))
        )
        // LOVE: exactly one own-slot transition and exactly +/- one, atomically proved.
        || (canReadLifetree() && validLoveCountChange('lifetrees', treeId))
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaff());

      // Loves: own-slot privacy plus atomic coupling to the public tally above.
      match /loves/{loveId} {
        allow read: if isSignedIn() && isOwner(loveId);
        allow create: if validLoveSlotCreate('lifetrees', treeId, loveId);
        allow delete: if validLoveSlotDelete('lifetrees', treeId, loveId);
        allow update: if false;
      }

      // A bed's occupancy — the accepted date-ranges, and NOTHING else: no guest, no identity.
      // Any signed-in being reads it to see busy/free nights (the full stays stay host/guest-
      // only). Written only by the bed's keeper or staff — in practice the Cloud Function
      // (admin) owns it on accept/decline, so a guest can never forge availability.
      match /occupancy/{stayId} {
        // Availability is public + identity-free by design: a signed-OUT visitor must see busy
        // nights too, or a booked bed would show as free. The payload carries only dates.
        allow read: if true;
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/lifetrees/$(treeId)).data.ownerId == request.auth.uid
          || isStaff()
        );
      }

      // The view-hold (domain/hold.ts) — a soft, self-expiring lock while a guest chooses nights.
      // Each being writes ONLY its own hold doc (id == its uid); anyone signed-in may read, to
      // see that another is choosing. It grants nothing and blocks nothing hard.
      match /holds/{holdUid} {
        allow read: if isSignedIn();
        // expiresAt is bounded to the near future (well above HOLD_TTL_MS=120s, with slack for
        // clock skew) so no one can mint a far-future hold that keeps the soft "being viewed"
        // advisory alive forever — the domain's self-expiring promise holds.
        allow create, update: if isSignedIn() && holdUid == request.auth.uid
          // The payload may not contradict the slot: readers prefer holderUid over the doc
          // id, so an unbound holderUid could dress a hold in another being's name.
          && request.resource.data.get('holderUid', holdUid) == holdUid
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt <= request.time.toMillis() + 600000;
        allow delete: if isSignedIn() && (holdUid == request.auth.uid || isStaff());
      }
    }

    // Persons: the canonical person entity (doc id = uid). World-readable (it carries a public
    // lid and, later, a public key); each user writes only their own. Staff may update (e.g. the
    // superadmin lid backfill — migrateBackfillLids) but never create-for or delete.
    match /persons/{personId} {
      allow read: if true;
      // THE HINGE IS GUARDED (ring 2026-08-17): persons/{uid} is the ONE table binding the
      // mortal name (auth uid) to the true name (lid) — the pivot every node crossing
      // re-anchors through. The body's uid may never disagree with the path, and a newborn
      // lid must be a real UUIDv7 (the shape every true name wears).
      allow create: if isSignedIn() && request.auth.uid == personId
        && request.resource.data.get('uid', personId) == personId
        && (
          !('lid' in request.resource.data)
          || request.resource.data.lid.matches('^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        )
        && (
          (
            request.resource.data.get('publicKeyPem', null) == null
            && !request.resource.data.keys().hasAny([
              'signingKeyFingerprint', 'signingEpochId',
              'signingState', 'signingAnchoredAt', 'signingFrozenAt', 'signingFreezeEventId'
            ])
          )
          || validSigningAnchor(personId)
        );
      allow update: if isSignedIn() && (
        (
          (request.auth.uid == personId || isStaff())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'publicKeyPem', 'signingKeyFingerprint', 'signingEpochId',
            'signingState', 'signingAnchoredAt', 'signingFrozenAt', 'signingFreezeEventId'
          ])
          && request.resource.data.get('uid', personId) == personId
          && (
            ('lid' in resource.data)
              // the true name never changes...
              ? request.resource.data.get('lid', '') == resource.data.get('lid', '')
              // ...and the one-time backfill may only set a well-formed UUIDv7.
              : (
                  !('lid' in request.resource.data)
                  || request.resource.data.lid.matches('^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
                )
          )
        )
        || (
          request.auth.uid == personId
          && !('signingEpochId' in resource.data)
          && (
            resource.data.get('publicKeyPem', null) == null
            || resource.data.get('publicKeyPem', '') == ''
            || resource.data.get('publicKeyPem', '') == request.resource.data.get('publicKeyPem', '')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'publicKeyPem', 'signingKeyFingerprint', 'signingEpochId',
            'signingState', 'signingAnchoredAt'
          ])
          && validSigningAnchor(personId)
        )
        || (request.auth.uid == personId && validSigningFreeze(personId))
      );
      allow delete: if false;

      // APPEND-ONLY KEY HISTORY — persons/{uid}/keys/{fingerprint}: one doc per identity key ever
      // published (doc id = a stable SHA-256 fingerprint of the pubkey), { pubkey, publishedAt }.
      // World-readable lineage; verification NOW STANDS ON ITS EXISTENCE (the lineage fallback in
      // verifiedCovenantSigners / verifiedDecisionSigners — history survives key rotation), so the
      // whole record is frozen: owner-create only; re-publishing the SAME key may touch its own doc
      // (a no-op merge) but neither the pubkey NOR its publishedAt can ever change under the
      // fingerprint. New publication is pinned to request.time; v3 verification stands on the
      // server-anchored keyEvents timeline rather than trusting a client-selected timestamp.
      // Never deleted — history is never rewritten.
      match /keys/{fingerprint} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == personId
          && request.resource.data.keys().hasOnly(['pubkey', 'publishedAt'])
          && request.resource.data.get('pubkey', '') != ''
          && request.resource.data.get('publishedAt', null) == request.time;
        allow update: if isSignedIn() && request.auth.uid == personId
          && request.resource.data.keys().hasOnly(['pubkey', 'publishedAt'])
          && request.resource.data.get('pubkey', '') == resource.data.get('pubkey', '')
          && request.resource.data.get('publishedAt', 0) == resource.data.get('publishedAt', 0);
        allow delete: if false;
      }

      // Append-only epoch events. A client may anchor the FIRST key or freeze the CURRENT one; both
      // are atomic with the person declaration and pinned to request.time. Rotation and recovery
      // events are Admin-SDK only because their cryptographic proofs/quorum are verified server-side.
      match /keyEvents/{eventId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == personId
          && request.resource.data.keys().hasOnly([
            'version', 'type', 'uid', 'lid', 'epochId', 'keyFingerprint',
            'recordedAt', 'claimedSuspectedSince'
          ])
          && request.resource.data.get('version', 0) == 1
          && request.resource.data.get('uid', '') == personId
          && request.resource.data.get('lid', '') != ''
          && request.resource.data.get('lid', '')
               == getAfter(/databases/$(database)/documents/persons/$(personId)).data.get('lid', '')
          && request.resource.data.get('recordedAt', null) == request.time
          && (
            (
              request.resource.data.get('type', '') == 'anchor'
              && eventId == request.resource.data.get('epochId', '')
              && eventId == 'anchor_' + request.resource.data.get('keyFingerprint', '')
              && getAfter(/databases/$(database)/documents/persons/$(personId)).data.get('signingEpochId', '') == eventId
              && getAfter(/databases/$(database)/documents/persons/$(personId)).data.get('signingKeyFingerprint', '')
                   == request.resource.data.get('keyFingerprint', '')
            )
            || (
              request.resource.data.get('type', '') == 'freeze'
              && eventId == 'freeze_' + request.resource.data.get('epochId', '')
              && getAfter(/databases/$(database)/documents/persons/$(personId)).data.get('signingState', '') == 'frozen'
              && getAfter(/databases/$(database)/documents/persons/$(personId)).data.get('signingFreezeEventId', '') == eventId
              && (
                !('claimedSuspectedSince' in request.resource.data)
                || (
                  request.resource.data.claimedSuspectedSince <= request.time
                  && request.resource.data.claimedSuspectedSince
                       >= get(/databases/$(database)/documents/persons/$(personId)/keyEvents/$(request.resource.data.get('epochId', ''))).data.get('recordedAt', request.time)
                )
              )
            )
          );
        allow update, delete: if false;
      }

      // Social recovery is mediated by callable functions: the candidate key proves itself, each
      // witness is checked against the validation web and their active signing epoch, and activation
      // re-checks three distinct hands atomically. Clients may inspect/share the proposal, never
      // manufacture or edit its state.
      match /keyRecoveries/{recoveryId} {
        allow read: if isSignedIn();
        allow write: if false;
        match /witnesses/{witnessUid} {
          allow read: if isSignedIn();
          allow write: if false;
        }
      }
    }

    // Visions: visibility-gated reads (protect fragile/early visions). A direct read keeps the
    // missing-visibility compatibility path; a LIST must prove public/node/author/staff and may
    // never use that path to sweep private records into a client. 'private' = author or staff.
    match /visions/{visionId} {
      allow get: if canReadVision();
      allow list: if canListVision();
      // THE BIRTH IS SIGNED: a vision wears its author's own uid (staff excepted — they
      // plant Root Visions for beings they plant trees for, and the node genesis).
      allow create: if isSignedIn()
        && (isStaff() || request.resource.data.get('authorId', '') == request.auth.uid);
      // Joining a vision is now a self-serve 'joined' link (see the links collection), NOT a write
      // to the vision doc — so editing the doc itself is restricted to its author or staff.
      // The vision grows its OWN chain (growVision): its head — latestHash/blockHeight — advances
      // freely on the author's (or staff's) write, but the GENESIS is frozen the moment it exists
      // (like a tree's/bed's root): the birth block can be BORN once (an absent genesisHash may be
      // set — createVision at birth, or the backfill on a legacy vision) but never REWRITTEN. So a
      // contribution may extend the chain, and no one may forge or replace its root. `lid` stays frozen.
      allow update: if isSignedIn() && (
        (
          (resource.data.authorId == request.auth.uid || isStaff())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lid', 'loveCount'])
          && (
            !('genesisHash' in resource.data)
            || request.resource.data.get('genesisHash', '') == resource.data.get('genesisHash', '')
          )
        )
        // LOVE: exactly one own-slot transition and exactly +/- one, atomically proved.
        || (canReadVision() && validLoveCountChange('visions', visionId))
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isStaff());

      // Loves: own-slot privacy plus atomic coupling to the public tally above.
      match /loves/{loveId} {
        allow read: if isSignedIn() && isOwner(loveId);
        allow create: if validLoveSlotCreate('visions', visionId, loveId);
        allow delete: if validLoveSlotDelete('visions', visionId, loveId);
        allow update: if false;
      }
    }

    // Pulses: Read public, Write signed in
    // NOTE: The validation-gated reach rule (a "protected" target only accepts reaches
    // from validated trees) would require cross-document reads of the target tree's
    // mirrored privacy flag at write time. To avoid weakening these rules with an
    // expensive get(), that rule is enforced in the service layer (sendReach) and the
    // UI (canReachTree). See src/services/firebase.ts -> sendReach.
    match /pulses/{pulseId} {
      // get = one document (per-doc gate, legacy-absent reads as public); list = a query
      // (constraint-provable, canListPulse). Fusing them let an unconstrained list leak.
      allow get: if canReadPulse();
      allow list: if canListPulse();
      // THE BIRTH IS SIGNED (ring 2026-08-17): every pulse wears the uid of the hand that
      // writes it — staff excepted (mend hands, the genesis ceremony). The one client flow
      // that wrote ANOTHER party's name (acceptAlignment's counterpart sync block) already
      // failed these rules at the foreign tree-head update, so it gets no carve-out here:
      // the settlement awaits its server callable (the ROADMAP debt), not a hole.
      allow create: if isSignedIn()
        && (isStaff() || request.resource.data.get('authorId', '') == request.auth.uid)
        && (
        // A WATERING pulse is the light mint's trust root (functions/witnessWatering): you author
        // your OWN, only on a tree you CARE (owner/co_owner/steward/staff), and may never
        // self-declare a guardian witness at creation — the confirmation is server-only. authorId
        // is bound here so the carer the mint pays is real (Lumo's review, 2026-07-20).
        request.resource.data.get('care', '') == 'watering'
          ? (request.resource.data.get('authorId', '') == request.auth.uid
             && (isStaff() || isTreeCarer(request.resource.data.get('lifetreeId', '')))
             && request.resource.data.get('wateringConfirmedBy', 'pending') != 'guardian')
          : ((request.resource.data.type != 'event'
              || !('communityId' in request.resource.data)   // standalone event — anyone may plant one
              || isStaff()
              || isCommunityOwner(request.resource.data.communityId))
             // An OFFERING OF CARE (ring 2026-09-06) is born OPEN: no client writes an answer at
             // birth. Acceptance is the server's (functions/acceptOffering); withdraw and decline
             // are the flips below.
             && (request.resource.data.get('type', '') != 'offering'
                 || request.resource.data.get('offeringStatus', 'open') == 'open'))
      );
      // The append-only ledger: a pulse's identity and chain fields (hash, previousHash, authorId,
      // type, createdAt, lifetreeId, treeId, communityId, participantUids, …) are FROZEN after
      // creation. Only the interaction/governance overlays below may change, and EACH is scoped to
      // its own key set via diff().affectedKeys() — so a "voter" or "translator" can never also
      // rewrite content or re-link the chain (the ledger stays tamper-evident and un-defaceable).
      allow update: if isSignedIn() && (
        // (a) Non-love interaction overlays — love has its own coupled branch below.
        //     Gated by the SAME visibility as reading: a pulse you cannot see is a pulse you
        //     cannot touch (before this, any signed-in account could write these keys on ANY
        //     pulse it knew the id of — including private reaches). And seenBy moves by
        //     append-exactly-your-own-uid, the vetoes arithmetic, so a receipt can be neither
        //     forged in another being's name nor erased. The H2H reading (aiInterpretation)
        //     stays a shared surface any READER may refresh — that is its design, not a leak.
        (
          canReadPulse()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['seenBy', 'aiInterpretation', 'updatedAt'])
          && (
               !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seenBy'])
               || (
                    request.resource.data.get('seenBy', []).hasAll(resource.data.get('seenBy', []))
                    && resource.data.get('seenBy', []).concat([request.auth.uid]).hasAll(request.resource.data.get('seenBy', []))
                    && request.auth.uid in request.resource.data.get('seenBy', [])
                  )
             )
        )

        // (b) LOVE: the private slot and both legacy tally fields move together by exactly one.
        || (canReadPulse() && validPulseLoveCountChange(pulseId))

        // (c) Watering confirmation is SERVER-ONLY: a guardian witnesses through the
        //     functions/witnessWatering callable (admin SDK), which derives the witness from the
        //     authenticated caller and mints the light atomically. No client may write
        //     wateringConfirmedBy / wateringConfirmation, so a witness can never be forged and
        //     aimed at an account (Lumo's review, 2026-07-20). Staff keep the mend-anything escape (g).

        // (d) Governance on a decision — voting and raising a concern (listening false→true) stay
        //     open to signed-in members; flipping STATUS or resuming (listening true→false) needs
        //     the proposer, community owner, or staff. Content/chain keys can't ride along — and
        //     the chain MARKS (enactedHash / withdrawnHash) may only move together with a status
        //     change, so a plain voter can never scribble a seal or a withdrawal mark on its own.
        || (
             resource.data.get('type', '') == 'decision'
             // The circle's own business: only a member (owner included) touches a decision's
             // governance overlay. Before this, ANY signed-in account could rewrite
             // votes/concerns/positions on any decision whose id it knew (the arrays audit).
             && (isStaff() || isCommunityMember(resource.data.get('communityId', '')))
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['votes', 'concerns', 'positions', 'listening', 'status', 'passedAt', 'enactedHash', 'withdrawnAt', 'rejectedAt', 'withdrawnHash', 'updatedAt'])
             // votes[] IS RETIRED (ring 2026-08-10): no shipped code writes it. This clause is a
             // TRANSITION tolerance for stale PWA bundles that still denormalise a signature onto
             // votes — append-exactly-your-own-uid (the vetoes arithmetic), so even a stale hand
             // can neither forge nor erase a voice. Remove the whole votes clause (and 'votes'
             // from hasOnly above) once the service-worker cycle has retired the old bundles.
             && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['votes'])
                  || (
                       request.resource.data.get('votes', []).hasAll(resource.data.get('votes', []))
                       && resource.data.get('votes', []).concat([request.auth.uid]).hasAll(request.resource.data.get('votes', []))
                     )
                )
             && (
                  request.resource.data.get('status', '') == resource.data.get('status', '')
                  || isStaff()
                  || resource.data.get('proposedBy', '') == request.auth.uid
                  || isCommunityOwner(resource.data.get('communityId', ''))
                )
             && (
                  !request.resource.data.diff(resource.data).affectedKeys().hasAny(['enactedHash', 'withdrawnHash'])
                  || request.resource.data.get('status', '') != resource.data.get('status', '')
                )
             && (
                  !(resource.data.get('listening', false) == true && request.resource.data.get('listening', false) == false)
                  || isStaff()
                  || resource.data.get('proposedBy', '') == request.auth.uid
                  || isCommunityOwner(resource.data.get('communityId', ''))
                )
           )

        // (e) Decision visibility flip — circle ↔ public square. Proposer, keeper or staff only;
        //     nothing else may ride along. Decisions are community-visible by default; showing
        //     one to the public is a deliberate act.
        || (
             resource.data.get('type', '') == 'decision'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['visibility', 'updatedAt'])
             && request.resource.data.get('visibility', '') in ['public', 'community']
             && (
                  isStaff()
                  || resource.data.get('proposedBy', '') == request.auth.uid
                  || isCommunityOwner(resource.data.get('communityId', ''))
                )
           )

        // (f) Event content edits — author, community owner, or staff; content keys only.
        || (
             resource.data.get('type', '') == 'event'
             && (isStaff() || resource.data.authorId == request.auth.uid || isCommunityOwner(resource.data.get('communityId', '')))
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['title', 'body', 'content', 'imageUrl', 'imageUrls', 'eventDate', 'eventLocation', 'visibility', 'updatedAt'])
           )

        // (g) The guardians' veto — a guardian of the pulse's tree may append exactly their
        //     own uid to `vetoes` on a growth mint, WITHIN the 72h window, and only if their
        //     guardianship PREDATES the mint (tenure — a sock account minted for the occasion
        //     has no voice; mirrors domain/guardianVeto.ts).
        || (
             resource.data.get('type', '') == 'tree_growth'
             && request.time < resource.data.createdAt + duration.value(72, 'h')
             && exists(/databases/$(database)/documents/links/$(request.auth.uid + '__guardian__' + resource.data.get('lifetreeId', '')))
             && get(/databases/$(database)/documents/links/$(request.auth.uid + '__guardian__' + resource.data.get('lifetreeId', ''))).data.createdAt <= resource.data.createdAt
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['vetoes', 'updatedAt'])
             && request.resource.data.get('vetoes', []).hasAll(resource.data.get('vetoes', []))
             && resource.data.get('vetoes', []).concat([request.auth.uid]).hasAll(request.resource.data.get('vetoes', []))
             && request.auth.uid in request.resource.data.get('vetoes', [])
           )

        // (h) The QR mint — the being remembers its printed link (domain/beingLink).
        //     Author or staff; only the qr overlay may change.
        || (
             (isStaff() || resource.data.authorId == request.auth.uid)
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['qr', 'updatedAt'])
           )

        // (i) The offering's lifecycle switch: its AUTHOR may pause or rewake it, a boolean and
        //     nothing else. Pausing hides it from the shared feed; the record itself stays.
        || (
             resource.data.get('type', '') == 'offering'
             && resource.data.authorId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['offeringActive', 'updatedAt'])
             && request.resource.data.get('offeringActive', null) is bool
           )

        // (i2) Offering content edits: the author (or staff) may retell the offering: its words,
        //      its face, its suggested appreciation, its detail door. The kind and any bed it
        //      stands for are frozen (a service must never silently become a bed), and the chain
        //      keys can never ride along.
        || (
             resource.data.get('type', '') == 'offering'
             && (isStaff() || resource.data.authorId == request.auth.uid)
             && resource.data.get('offeringStatus', 'open') != 'accepted'   // the agreed words stand
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['title', 'body', 'content', 'imageUrl', 'imageUrls',
                            'offeringAppreciationLight', 'offeringUrl', 'visibility', 'updatedAt'])
           )

        // (i3) WITHDRAW — the offering of care's author takes an OPEN offering back (domain/
        //      offering.canWithdrawOffering): one flip to 'withdrawn', its moment beside it,
        //      nothing else riding. Answered offerings never move again.
        || (
             resource.data.get('type', '') == 'offering'
             && resource.data.authorId == request.auth.uid
             && resource.data.get('offeredToKind', '') in ['tree', 'vision']
             && resource.data.get('offeringStatus', 'open') == 'open'
             && request.resource.data.get('offeringStatus', '') == 'withdrawn'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['offeringStatus', 'offeringAnsweredAt', 'updatedAt'])
           )

        // (i4) DECLINE — a hand that STANDS for the receiver answers no (canAnswerOffering): a
        //      tree's carer (keeper / co-owner / steward), a vision's author; never the offering's
        //      own author. 'accepted' is NOT writable here — acceptance mints twin blocks on both
        //      chains and is the server's alone (functions/acceptOffering).
        || (
             resource.data.get('type', '') == 'offering'
             && resource.data.authorId != request.auth.uid
             && resource.data.get('offeringStatus', 'open') == 'open'
             && request.resource.data.get('offeringStatus', '') == 'declined'
             && request.resource.data.get('offeringAnsweredBy', '') == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['offeringStatus', 'offeringAnsweredAt', 'offeringAnsweredBy', 'updatedAt'])
             && (
                  (resource.data.get('offeredToKind', '') == 'tree'
                   && (isStaff() || isTreeCarer(resource.data.get('offeredToId', ''))))
                  || (resource.data.get('offeredToKind', '') == 'vision'
                      && resource.data.get('offeredToId', '') != ''
                      && exists(/databases/$(database)/documents/visions/$(resource.data.offeredToId))
                      && (isStaff() || get(/databases/$(database)/documents/visions/$(resource.data.offeredToId)).data.authorId == request.auth.uid))
                )
           )

        // (h) RETRACTION — a reach's AUTHOR may mark their own message retracted (ring
        //     2026-08-10). The text is NEVER rewritten (content stays frozen; on locked chains
        //     it is hashed) and the doc is never deleted (a tree-sent reach is a block on the
        //     sender's chain — deleting it would sever previousHash for every block after).
        //     retractedAt rides OUTSIDE the hashed block fields, so the seal stays true while
        //     the room stops repeating the words. The accidental message, honestly withdrawn.
        || (
             resource.data.get('type', '') == 'reach'
             && resource.data.authorId == request.auth.uid
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['retractedAt', 'updatedAt'])
           )

        // (i3) THE PLACE-OF-RECORD MEND — staff move a mis-stamped event to its true place
        //      (ui/PlaceOfRecord; ring 2026-08-11). Exactly {domain, updatedAt, rehomedAt} and
        //      nothing else; `domain` is outside the hashed block fields, so the seal stays
        //      true while the being changes address. Authors and community owners deliberately
        //      have NO overlay carrying `domain`: a being cannot be moved between places by
        //      the hand that made it, only by the node's stewards. This precise clause stands
        //      on its own feet even while the general staff escape (j) below still exists —
        //      retiring (j) into enumerated staff key-sets is a named shelf item, and this is
        //      its first stone (Lumo's review, 2026-08-11).
        || (
             isStaff()
             && resource.data.get('type', '') == 'event'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['domain', 'updatedAt', 'rehomedAt'])
             && request.resource.data.get('domain', '') is string
             && request.resource.data.get('domain', '') != ''
           )

        // (j) Staff may mend anything.
        || isStaff()
      );
      // DRAFT VANISHES, MINTED WITHDRAWS: a decision may be erased only while it is still its
      // proposer's own draft — never once passed, and never once another voice stands on it (a
      // second vote or any position). Signatures live in a subcollection the rules cannot read;
      // that half of the guard is enforced by deleteDecision (domain/decision.decisionDeletable).
      // Everything shared retires by WITHDRAWING — a chain-marked status, never an erasure. Staff
      // keep the mend-anything escape (the amber-dot posture, mirrored across overlays).
      allow delete: if isSignedIn() && (
        isStaff()
        || (
             (resource.data.get('authorId', '') == request.auth.uid || isCommunityOwner(resource.data.get('communityId', '')))
             // A REACH is never plainly deleted, not even by its author (retraction is its
             // way) — and NO block on a tree's chain is (deleting below the head severs
             // previousHash for every block after). The ONE exit for any chain block is the
             // UNMINT branch below: exactly the head, with the rollback riding along. This
             // closes the mid-chain delete for the whole tree chain (first-sight finding 2).
             && resource.data.get('type', '') != 'reach'
             && !(resource.data.get('lifetreeId', '') != '' && resource.data.get('hash', '') != '')
             && (
                  resource.data.get('type', '') != 'decision'
                  || (
                       resource.data.get('status', '') != 'passed'
                       // No voice but the proposer's own — hasOnly, so a malformed/legacy votes
                       // array holding someone ELSE's single voice still protects the record
                       // (byte-for-byte the domain's votes.some(v => v !== proposedBy) reading).
                       && resource.data.get('votes', []).hasOnly([resource.data.get('proposedBy', '')])
                       && resource.data.get('positions', []).size() == 0
                     )
                )
           )

        // THE UNMINT (ring 2026-08-15) — an accidental LAST mint may be taken back by its
        // author: only the HEAD block (the tree's latestHash is this hash), only in the same
        // transaction that rolls the head back to previousHash with the height stepping down
        // one — so the chain is never severed, only shortened by exactly its newest link.
        // ANY block kind at the head may be unsaid this way — a growth, a tree-sent reach,
        // an alignment — because the severing argument only binds BELOW the head (a head
        // reach unsaid is the message fully unsent, the room's copy included; below the
        // head, retraction remains the way). Two stand forever: a guardian-WITNESSED
        // watering (its light is already minted; rays are append-only) and decisions
        // (their own lifecycle law governs them).
        || (
             resource.data.get('authorId', '') == request.auth.uid
             && resource.data.get('lifetreeId', '') != ''
             && resource.data.get('type', '') != 'decision'
             && resource.data.get('wateringConfirmedBy', '') != 'guardian'
             // NOTHING CO-HELD CAN BE UNSAID: once another being's mark lands on the block
             // (a read receipt, a love, a guardian's veto, an alignment's paired mint), it
             // stops being only its author's word and stands. Mirrors domain/unmint.isCoHeld.
             && resource.data.get('seenBy', []).hasOnly([request.auth.uid])
             && resource.data.get('loveCount', 0) == 0
             && resource.data.get('vetoes', []).size() == 0
             && resource.data.get('matchId', '') == ''
             && resource.data.get('matchedLifetreeId', '') == ''
             && resource.data.get('offeringId', '') == ''   // an accepted offering's twin stands
             && get(/databases/$(database)/documents/lifetrees/$(resource.data.lifetreeId)).data.get('latestHash', '') == resource.data.get('hash', '')
             && getAfter(/databases/$(database)/documents/lifetrees/$(resource.data.lifetreeId)).data.get('latestHash', '') == resource.data.get('previousHash', '')
             && getAfter(/databases/$(database)/documents/lifetrees/$(resource.data.lifetreeId)).data.get('blockHeight', 0)
                  == get(/databases/$(database)/documents/lifetrees/$(resource.data.lifetreeId)).data.get('blockHeight', 0) - 1
           )
      );

      // Loves: a pulse may reveal only YOUR mark; the slot and both legacy tally fields
      // move together in the same transaction.
      match /loves/{loveId} {
          allow read: if isSignedIn() && isOwner(loveId);
          allow create: if validPulseLoveSlotCreate(pulseId, loveId);
          allow delete: if validPulseLoveSlotDelete(pulseId, loveId);
          allow update: if false;
      }

      // Decision signatures — a decision seven people SIGN (domain/decision.ts, Covenant phase 3). A
      // vote is an Ed25519 signature over the decision's frozen identity, one per member. This is the
      // OPEN-membership analogue of covenants/{id}/signatures: no fixed roster — ANY member of the
      // decision's community may sign, each ONLY their own slot (doc id == their uid). A signature is
      // IMMUTABLE (update:false) — the pubkey + sig are frozen the moment they land — so anyone can
      // re-run verifyDecision and confirm enactment is real, not merely a 'passed' flag. The parent
      // pulse must be a decision, and the writer must be a member of its community (isCommunityMember,
      // mirrored in the service). Any signed-in reader may read, to verify.
      match /signatures/{sigUid} {
        allow read: if isSignedIn();
        // FIELD-LOCK: exactly the signature fields, nothing else — a body `uid` (or any smuggled
        // field) is refused, so a record can never carry a claim about WHO signed; the doc id is the
        // only signer, and the readers treat it as path-authoritative.
        allow create: if isSignedIn() && sigUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'sig', 'pubkey', 'version', 'keyFingerprint', 'epochId', 'recordedAt', 'position'
          ])
          && isCurrentEpochSignature(sigUid)
          && get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('type', '') == 'decision'
          && isCommunityMember(get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('communityId', ''));
        allow update: if false;
        allow delete: if isStaff();
      }

      // THE KEEPER'S OBSERVATION (ring 2026-08-24) — a consecration/step-in care stands
      // OBSERVED when ONE keeper of the community, NOT the consecrator, takes their own
      // witness slot. The signatures pattern: doc id = the mortal uid the rules verify;
      // the body carries the LID — the true name that survives the crossing — pinned
      // against persons/{uid} so no witness can wear another being's name. Append-only:
      // an observation can be neither forged, transferred, nor erased.
      match /witnesses/{witnessUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && witnessUid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'lid', 'name', 'witnessedAt'])
          && request.resource.data.get('uid', '') == request.auth.uid
          && request.resource.data.get('lid', '')
               == get(/databases/$(database)/documents/persons/$(request.auth.uid)).data.get('lid', '__none__')
          && request.resource.data.get('witnessedAt', null) == request.time
          && get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('care', '') == true
          && get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('lightHouseId', '') != ''
          && get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('authorId', '') != request.auth.uid
          && isCommunityKeeper(get(/databases/$(database)/documents/pulses/$(pulseId)).data.get('communityId', ''));
        allow update: if false;
        allow delete: if isStaff();
      }
    }

    // Alignments: Read public, Write signed in
    // Stays — a request to sleep in a specific BED (domain/stay.ts). The guest creates their
    // own request; hostUid is frozen to the BED's keeper (verified server-side, so a guest can
    // neither forge the host nor aim a stay at a non-bed). The keeper (or staff) answers with a
    // status — and ONLY the status/updatedAt may change, so bedId and the guest's denormalised
    // face are frozen for the stay's life. Either side may withdraw/read their own.
    match /stays/{stayId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || resource.data.hostUid == request.auth.uid
        || isStaff()
      );
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('status', '') == 'requested'
        && request.resource.data.get('bedId', '') != ''
        // Dates must be well-formed and ordered server-side, so a direct write can't carry a
        // reversed range or a nights count that disagrees with the range the host answers.
        && request.resource.data.fromDate is string
        && request.resource.data.toDate is string
        && request.resource.data.fromDate < request.resource.data.toDate
        && get(/databases/$(database)/documents/lifetrees/$(request.resource.data.bedId)).data.get('treeType', '') == 'BED'
        && request.resource.data.get('hostUid', '') ==
             get(/databases/$(database)/documents/lifetrees/$(request.resource.data.bedId)).data.ownerId;
      allow update: if isSignedIn()
        && (resource.data.hostUid == request.auth.uid || isStaff())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.get('status', '') in ['requested', 'accepted', 'declined'];
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || resource.data.hostUid == request.auth.uid
        || isStaff()
      );
    }

    // The care economy (domain/support.ts): a year of support for one tree. Written ONLY by
    // the payment rail (Cloud Functions bypass rules); the app just reads its own flows.
    match /supports/{supportId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Rays — light kindled from witnessed care (the sun ring; domain/light.ts). SERVER-ONLY:
    // no client may ever write a ray, so light can never be self-minted (the mint lives in
    // functions/onWateringKindled|onWateringConfirmed, admin SDK, bypassing these rules).
    // SOLITARY LIGHT IS PRIVATE (ring 2026-07-20): a being reads only their OWN rays; the
    // community glow is a later, aggregated view, never another being's individual light.
    match /rays/{rayId} {
      allow read: if isSignedIn() && (resource.data.holderUid == request.auth.uid || isStaff());
      allow write: if false;
    }

    // The glow ledger — a community's commons of dissolved light (the last spend; later the
    // prism's share and the idle fade). SERVER-WRITTEN only, like rays; readable by any
    // signed-in being, because a community's warmth is communal, never a private balance.
    // glow/NODE is the instance commons, the home of last resort.
    match /glow/{homeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /alignments/{id} {
      allow read: if true;
      // THE BIRTH IS SIGNED: an alignment is proposed in the proposer's own name.
      allow create: if isSignedIn()
        && (isStaff() || request.resource.data.get('initiatorUid', '') == request.auth.uid);
      // Field-level: (a) the discussion — either participant may write `messages` while the
      // alignment is still open; (b) settling — only the TARGET may flip `status` (accept mints the
      // sync-blocks in the same transaction; decline is a plain flip). The initiator can no longer
      // self-accept, and no one can rewrite the pulses/trees an alignment points at.
      allow update: if isSignedIn() && (
        (
          (resource.data.targetUid == request.auth.uid || resource.data.initiatorUid == request.auth.uid)
          && resource.data.status == 'PENDING'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messages'])
        )
        || (
          resource.data.targetUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
        || isStaff()
      );
      allow delete: if isStaff();
    }

    // Covenants — the two-sided cryptographic mint (domain/covenant.ts). A covenant is a Being with
    // its OWN chain and a FROZEN IDENTITY: proposed with title/body/quorum/kind, its parties named by
    // `party` links, each party signing its own slot in the /signatures subcollection. It SEALS only
    // when a quorum of signatures verify. Un-forgeability is the SIGNATURES (verifyCovenant), not the
    // status flag — so the doc's identity is frozen and only the chain head / status may advance.
    match /covenants/{id} {
      allow read: if isSignedIn();
      // Create names yourself as the proposer (staff exempt — the alignment retrofit migration).
      allow create: if isSignedIn() && (isStaff() || request.resource.data.proposedBy == request.auth.uid);
      // FREEZE the identity: lid/genesisHash/kind/title/body/quorum/proposedBy/alignmentId/createdAt
      // never change — only status advances (proposed → sealed/broken) and the chain head moves. What
      // a party signed can never shift under them. A party, the proposer, or staff may advance it.
      allow update: if isSignedIn()
        && (isCovenantParty(id) || resource.data.proposedBy == request.auth.uid || isStaff())
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'latestHash', 'blockHeight', 'sealedAt'])
        && request.resource.data.get('status', '') in ['proposed', 'sealed', 'broken'];
      allow delete: if isStaff();

      // Per-party signatures — the crypto the seal stands on. Each party writes ONLY their own slot
      // (doc id == their uid) and only if they are a party (a `party` link exists). A signature is
      // IMMUTABLE (update:false) — the pubkey + sig are frozen the moment they land. Any signed-in
      // reader may read, so anyone can re-run verifyCovenant and confirm the seal is real.
      match /signatures/{sigUid} {
        allow read: if isSignedIn();
        // FIELD-LOCK: exactly the signature fields, nothing else — a body `uid` (or any smuggled
        // field) is refused, so a record can never carry a claim about WHO signed; the doc id is the
        // only signer, and the readers treat it as path-authoritative.
        allow create: if isSignedIn() && sigUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'sig', 'pubkey', 'version', 'keyFingerprint', 'epochId', 'recordedAt'
          ])
          && isCurrentEpochSignature(sigUid)
          && exists(/databases/$(database)/documents/links/$(request.auth.uid + '__party__' + id));
        allow update: if false;
        allow delete: if isStaff();
      }
    }

    // Communities: Read public, Write staff/owner
    match /communities/{communityId} {
      allow read: if true;
      // THE BIRTH IS SIGNED: a community is founded in the founder's own name (both the
      // anchor ownerId and, when carried, the legacy founderUserId).
      allow create: if isSignedIn() && (isStaff() || (
        request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('founderUserId', request.auth.uid) == request.auth.uid
      ));
      // Keepers are FULL PEERS (ring 2026-08-12): the founding ownerId and every `keeper`
      // link holder edit alike. The ANCHOR itself (`ownerId`) is frozen against client
      // hands like `lid` — succession moves only through the resignKeeper transaction,
      // which refuses to leave a community keeperless. (Before this, an owner could hand
      // the anchor to any uid — or to nobody — in one client write.)
      // `domainVerification` is SERVER-OBSERVED truth (a DNS control proof, written only by
      // the checkDomainVerification callable via Admin SDK) — no client hand may write it,
      // or the badge would be a self-claim wearing a proof's clothes.
      allow update: if isSignedIn() && (
        (
          (resource.data.ownerId == request.auth.uid || hasKeeperLink(communityId) || isStaff())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lid', 'loveCount', 'ownerId', 'bornOn', 'domainVerification', 'formedAt', 'formedBy'])
        )
        // LOVE: exactly one own-slot transition and exactly +/- one, atomically proved.
        || validLoveCountChange('communities', communityId)
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || hasKeeperLink(communityId) || isStaff());

      // Loves: own-slot privacy plus atomic coupling to the public tally above.
      match /loves/{loveId} {
        allow read: if isSignedIn() && isOwner(loveId);
        allow create: if validLoveSlotCreate('communities', communityId, loveId);
        allow delete: if validLoveSlotDelete('communities', communityId, loveId);
        allow update: if false;
      }
    }

    // LightHouses: sacred places per domain (read public, write owner/staff).
    match /lightHouses/{lightHouseId} {
      // The community's choice is LAW, enforced AT REST — not a client-only veil. Private by
      // default: absent visibility = 'community'. Membership is proven by the PRIMARY communityId,
      // the one get() the rules engine can afford (isCommunityMember). So a signed-in NON-member
      // can no longer read a community house's raw doc; canViewLightHouse (domain/lightHouse.ts)
      // is now a belt, not the lock. Signed-out see public only.
      //   HONEST LIMIT: a house sheltering MULTIPLE communities via LIN `lightHouse __shelters__
      //   community` edges is gated HERE only on its PRIMARY communityId — full multi-edge
      //   membership needs an ACL denormalisation on the doc (out of scope; see the DECISIONS ring).
      //   Map/domain reads MUST therefore be a rule-provable UNION (public ∪ node ∪ my-community
      //   houses ∪ my own — services/firebase/trees.ts), or the whole list query is rejected.
      allow read: if canReadLightHouse();
      // THE BIRTH IS SIGNED: consecrated in the consecrator's own name (a keeper who
      // consecrates for their community still signs as themself).
      allow create: if isSignedIn()
        && (isStaff() || request.resource.data.get('ownerId', '') == request.auth.uid);
      // CARE TOUCH (ring 2026-08-24): the primary community's keeper may refresh
      // lastCaredAt alone — a step-in care warms a house its keeper does not own.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCaredAt', 'updatedAt'])
        && isCommunityKeeper(resource.data.get('communityId', ''));
      // Belonging is LIN edges now (lightHouse __shelters__ community) — no array clause.
      // The lid (the true name, load-bearing for QR links) is frozen on every update path.
      allow update: if isSignedIn() && (
        (
          (resource.data.ownerId == request.auth.uid || isStaff())
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lid', 'loveCount'])
        )
        // LOVE: exactly one own-slot transition and exactly +/- one, atomically proved.
        || (canReadLightHouse() && validLoveCountChange('lightHouses', lightHouseId))
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaff());

      // Loves: own-slot privacy plus atomic coupling to the public tally above.
      // Own-slot read is why a Light House CAN wear a heart even when its own read is member-gated:
      // each being sees only their own mark, so a guarded house never leaks who loved it.
      match /loves/{loveId} {
        allow read: if isSignedIn() && isOwner(loveId);
        allow create: if validLoveSlotCreate('lightHouses', lightHouseId, loveId);
        allow delete: if validLoveSlotDelete('lightHouses', lightHouseId, loveId);
        allow update: if false;
      }
    }

    // Invite requests — anyone (signed out) can ask to join; only staff can read/triage.
    match /inviteRequests/{requestId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, list: if isStaff();
      allow update, delete: if isStaff();
    }

    // Community invitations — the shareable door key (/i/<id>), see domain/communityDoor.ts.
    // Unguessable auto-id: anyone holding the link may GET it (to be greeted before joining);
    // listing stays with the community's keepers. Append-only in spirit: revocation is a
    // mark (revokedAt), never a delete — the used invitation IS the provenance record.
    match /communityInvites/{inviteId} {
      allow get: if true;
      allow list: if isSignedIn() && (isStaff() || isCommunityKeeper(resource.data.communityId));
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCommunityKeeper(request.resource.data.communityId);
      // The only mutation is revocation by a keeper: stamp a non-null revokedAt onto an invite
      // that is not already revoked, and touch nothing else. Revocation is one-way — a revoked
      // key is never resurrected (no clearing revokedAt back to null), keeping the mark honest.
      allow update: if isSignedIn()
        && isCommunityKeeper(resource.data.communityId)
        && resource.data.get('revokedAt', null) == null
        && request.resource.data.get('revokedAt', null) != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']);
      allow delete: if isStaff();
    }

    // Network onboarding invites. The invite id is an unguessable token, so a single
    // doc is fetchable by anyone holding the link (to lock the email on the sign-up
    // page); listing is staff-only. The inviter creates; the invited user consumes it.
    match /networkInvites/{inviteId} {
      allow get: if true;
      allow list: if isSignedIn() && (isStaff() || resource.data.invitedByUserId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.invitedByUserId == request.auth.uid;
      // The only legitimate update is the invited user consuming a still-pending invite: they may
      // flip it to 'accepted' and stamp THEMSELVES, but may not alter the locked email, inviter,
      // or the node it carries (which drives the membership the CF mints on acceptance).
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedByUserId == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.invitedByUserId == resource.data.invitedByUserId
        && request.resource.data.get('nodeCommunityId', '') == resource.data.get('nodeCommunityId', '')
        && request.resource.data.get('nodeDomain', '') == resource.data.get('nodeDomain', '');
      allow delete: if isStaff();
    }

    // Tree Circle invites. The Lifetree owner creates invites; the invitee or inviter
    // can read theirs; the invitee declines and the inviter revokes. Acceptance (which
    // also writes the tree's role arrays + the rooted community) goes through the
    // acceptTreeInvite Cloud Function with admin rights — never a direct client write.
    match /treeOwnershipInvites/{inviteId} {
      // A single invitation: its invitee and its inviter (and staff). The LEDGER of a tree's
      // invitations (list by lifetreeId) belongs to the tree's CARERS — owner, co_owner, steward —
      // so the circle can see who was invited, as what, and withdraw; the invitee lists their own.
      allow get: if isSignedIn() && (
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedByUserId == request.auth.uid ||
        isStaff() ||
        isTreeCarer(resource.data.lifetreeId)
      );
      allow list: if isSignedIn() && (
        isStaff() ||
        resource.data.invitedUserId == request.auth.uid ||
        resource.data.invitedByUserId == request.auth.uid ||
        isTreeCarer(resource.data.lifetreeId)
      );
      // The owner (or staff) invites any role; a carer (co_owner / steward) may open only the
      // OPEN layer — guardian / observer — never the deeper caring roles. Every invitation is
      // born pending and self-attributed.
      allow create: if isSignedIn() &&
        request.resource.data.invitedByUserId == request.auth.uid &&
        request.resource.data.get('status', '') == 'pending' &&
        (isStaff() || isTreeOwner(request.resource.data.lifetreeId) ||
          (isTreeCarer(request.resource.data.lifetreeId) && request.resource.data.get('role', '') in ['guardian', 'observer']));
      // Decline (the invitee) / revoke (the inviter, or the tree's owner for any invitation on
      // their tree). One-way marks on a PENDING invitation, touching only the status and its
      // stamp. Acceptance is server-only (acceptTreeInvite, admin SDK).
      allow update: if isSignedIn() &&
        resource.data.get('status', '') == 'pending' &&
        (
          (resource.data.invitedUserId == request.auth.uid && request.resource.data.status == 'declined') ||
          ((resource.data.invitedByUserId == request.auth.uid || isTreeOwner(resource.data.lifetreeId) || isStaff())
            && request.resource.data.status == 'revoked')
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedAt', 'revokedAt', 'updatedAt']);
      allow delete: if isStaff();
    }

    // Intelligence Commons -------------------------------------------------

    // Intelligences: public ones are world-readable; private ones only to owner/staff.
    match /intelligences/{intelligenceId} {
      allow read: if resource.data.public == true ||
        (isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaff()));
      // THE BIRTH IS SIGNED — with one lawful delegation: a community KEEPER connects the
      // community's intelligence, and the doc wears the COMMUNITY OWNER's uid (the section's
      // management queries key on it). Only a real keeper of THAT community may do so, and
      // only with that community's true owner — never an arbitrary name.
      allow create: if isSignedIn() && (
        isStaff()
        || request.resource.data.get('ownerId', '') == request.auth.uid
        || (
          request.resource.data.get('credentialScope', '') == 'community'
          && isCommunityKeeper(request.resource.data.get('credentialOwnerId', ''))
          && request.resource.data.get('ownerId', '')
               == get(/databases/$(database)/documents/communities/$(request.resource.data.credentialOwnerId)).data.ownerId
        )
      );
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isStaff());
    }

    // Personas: behaviour templates, world-readable; only staff curate them.
    match /personas/{personaId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Memories: public to all, community memory to signed-in members, private to staff.
    match /memories/{memoryId} {
      allow read: if resource.data.visibility == 'public' ||
        isStaff() ||
        (isSignedIn() && resource.data.visibility == 'community');
      // THE BIRTH IS SIGNED: a memory carries its writer's own uid (createMemory now
      // stamps ownerId), and a COMMUNITY memory may only be laid down by that community's
      // keeper — mirroring the update gate below.
      allow create: if isSignedIn()
        && (isStaff() || request.resource.data.get('ownerId', '') == request.auth.uid)
        && (
          !('communityId' in request.resource.data)
          || isStaff()
          || isCommunityOwner(request.resource.data.communityId)
        );
      allow update, delete: if isSignedIn() &&
        (isStaff() || isCommunityOwner(resource.data.communityId));
    }

    // (Governance decisions are now pulses of type 'decision' — see the /pulses rules.
    // create: any signed-in member [non-event branch]; update: signed-in, for voting.)

    // Links — the LIN as data: directed edges between entities {from, rel, to}. Edges are
    // world-readable (they lived on world-readable docs). A user self-creates/removes their own
    // 'guardian'/'joined' edges; role/member edges are server-only (the acceptTreeInvite Cloud
    // Function via the Admin SDK). Staff may create any edge (the one-time migration). Immutable.
    //
    // 'participant' is the exception whose `from` is a LIFETREE (a tree enlisted in an event/vision):
    // only that tree's OWNER may add or remove it. It grants NO privileges — no rule below reads a
    // 'participant' edge — so it is safe as a self-serve, owner-gated membership marker.
    match /links/{linkId} {
      allow read: if true;
      // The doc id MUST equal `from__rel__to` (domain/link.ts linkId). Authority is resolved
      // by PATH elsewhere (hasLink/isCommunityKeeper/isTreeCarer do exists() on a computed
      // path), and exists() is blind to a doc's data — so without this binding a self-serve
      // link (rel 'joined') placed at a privileged path (…__steward__…, …__co_owner__…) would
      // be read as that role. Binding id to data closes the whole forgery class; every real
      // writer already uses linkId(), so nothing legitimate breaks.
      allow create: if linkId == request.resource.data.from + '__' + request.resource.data.rel + '__' + request.resource.data.to
        && (isStaff()
        || (isSignedIn() && request.resource.data.from == request.auth.uid
            && request.resource.data.rel in ['guardian', 'joined'])
        // A knock at the door — possible unless the community's door is closed.
        || (isSignedIn() && request.resource.data.from == request.auth.uid
            && request.resource.data.rel == 'join_request'
            && communityDoor(request.resource.data.to) != 'closed')
        // A knock for KEEPERSHIP (ring 2026-08-12) — at a community or at a lifetree. Grants
        // nothing: at a community a sitting keeper answers and the SERVER mints the keeper
        // link (after the living-tree proof); at a lifetree the owner answers through the
        // tree-circle invite, choosing the role. The target must exist — a knock at nothing
        // is noise the keeper lists would have to carry forever.
        || (isSignedIn() && request.resource.data.from == request.auth.uid
            && request.resource.data.rel == 'keeper_request'
            && (exists(/databases/$(database)/documents/communities/$(request.resource.data.to))
                || exists(/databases/$(database)/documents/lifetrees/$(request.resource.data.to))))
        || (isSignedIn() && request.resource.data.rel == 'participant'
            && isTreeOwner(request.resource.data.from))
        // A tree stands in ANOTHER community's forest (ring 2026-08-24) — through the
        // community's own door: OPEN, the tree's owner steps in self-serve; any door, the
        // keeper welcomes the tree. Grants nothing; the forest queries alone read it.
        || (isSignedIn() && request.resource.data.rel == 'grows_in'
            && exists(/databases/$(database)/documents/lifetrees/$(request.resource.data.from))
            && (
              // A tree CARER (owner/co_owner/steward) steps into an open-door garden;
              // any door, the community's keeper welcomes the tree (ring 2026-08-25).
              (isTreeCarer(request.resource.data.from) && communityDoor(request.resource.data.to) == 'open')
              || isCommunityKeeper(request.resource.data.to)
            ))
        // INTERBEING MATRIX: a founding owner or keeper-link peer may attest only FROM their
        // own community. Door stewards are deliberately excluded: they keep admission, not the
        // community's outward voice.
        // The edge points TO another real community. The first direction is a proposal; the reverse
        // can be minted only by the other community's owner/keeper peer, so reciprocity is derived from
        // two independently authorised statements. These edges grant no privilege anywhere.
        || (isSignedIn()
            && request.resource.data.rel in ['collaborates_with', 'recognises', 'shares_resources_with']
            && request.resource.data.from != request.resource.data.to
            && exists(/databases/$(database)/documents/communities/$(request.resource.data.from))
            && exists(/databases/$(database)/documents/communities/$(request.resource.data.to))
            && isCommunityOwner(request.resource.data.from)
            && request.resource.data.get('type', '') == 'link'
            && request.resource.data.get('lid', '') is string
            && request.resource.data.get('lid', '') != ''
            && request.resource.data.get('createdAt', null) == request.time
            && request.resource.data.keys().hasAll(['lid', 'type', 'rel', 'from', 'to', 'createdAt'])
            && request.resource.data.keys().hasOnly(['lid', 'type', 'rel', 'from', 'to', 'createdAt']))
        // Rooting: a lightHouse's keeper roots THEIR lightHouse in a tree (from = lightHouse id).
        || (isSignedIn() && request.resource.data.rel in ['rooted', 'shelters']
            && get(/databases/$(database)/documents/lightHouses/$(request.resource.data.from)).data.ownerId == request.auth.uid)
        // Membership through the DOOR (domain/communityDoor.ts): a keeper (owner or steward)
        // accepts a knock; or the joiner steps in themself while the door is open; or they
        // arrive holding a live invitation (which also carries provenance on the edge).
        || (isSignedIn() && request.resource.data.rel == 'member'
            && (isCommunityKeeper(request.resource.data.to)
                || (request.resource.data.from == request.auth.uid
                    && (communityDoor(request.resource.data.to) == 'open'
                        || inviteOpensDoor(request.resource.data.get('inviteId', ''), request.resource.data.to)))))
        // The hand that welcomed (ring 2026-08-21): "I was welcomed by THIS person" —
        // from = the newcomer (self-asserted arrival), to = the inviter, PROVEN against the
        // invitation itself (its creator field), so no one can dress their arrival in an
        // arbitrary sponsor's name. Grants nothing; append-only (the delete clause refuses).
        || (isSignedIn() && request.resource.data.from == request.auth.uid
            && request.resource.data.rel == 'welcomed_by'
            && request.resource.data.from != request.resource.data.to
            && request.resource.data.get('inviteId', '') != ''
            // The one client door: a community invitation (network/tree/keeper acceptances
            // mint their marks server-side through the Admin SDK).
            && exists(/databases/$(database)/documents/communityInvites/$(request.resource.data.inviteId))
            && get(/databases/$(database)/documents/communityInvites/$(request.resource.data.inviteId)).data.get('createdBy', '') == request.resource.data.to)
        // Provenance: "I arrived into THIS community through this invitation" — from = newcomer,
        // to = the community, and inviteId names the real (keeper-minted) invitation; the inviter
        // is that invite's createdBy. Per-community, so arriving in two places leaves two marks.
        // Grants nothing (no rule reads it) and is append-only (see the delete clause). It is
        // deliberately NOT guardianship: power over a being flows from that being's keeper's
        // later choice, never from the door itself.
        || (isSignedIn() && request.resource.data.from == request.auth.uid
            && request.resource.data.rel == 'invited_by'
            && request.resource.data.get('inviteId', '') != ''
            && exists(/databases/$(database)/documents/communityInvites/$(request.resource.data.inviteId))
            && get(/databases/$(database)/documents/communityInvites/$(request.resource.data.inviteId)).data.communityId == request.resource.data.to)
        // The community owner appoints stewards — delegated door-keepers. A steward may step
        // down themself (the from == uid delete clause below); the owner may also remove them.
        || (isSignedIn() && request.resource.data.rel == 'steward'
            && isCommunityOwner(request.resource.data.to))
        // A covenant's PROPOSER mints the roster: one `party` link per party (from = a party's uid,
        // to = the covenant). Only that covenant's proposer may (its proposedBy). Grants no power on
        // its own — the crypto lives in the covenants/{id}/signatures subcollection. Staff (the
        // retrofit migration) are covered by the isStaff() branch at the top of this create rule.
        // The roster may only grow while the covenant is still 'proposed' — once it SEALS (or breaks),
        // the signed identity is frozen: adding a party would change what every signer signed and let a
        // proposer retroactively un-verify (repudiate) a sealed covenant. The service mints the whole
        // roster atomically at propose time, so nothing legitimate needs to add a party later.
        || (isSignedIn() && request.resource.data.rel == 'party'
            && exists(/databases/$(database)/documents/covenants/$(request.resource.data.to))
            && get(/databases/$(database)/documents/covenants/$(request.resource.data.to)).data.proposedBy == request.auth.uid
            && get(/databases/$(database)/documents/covenants/$(request.resource.data.to)).data.get('status', 'proposed') == 'proposed'));
      allow delete: if isSignedIn() && (
        // Append-only provenance: even its subject may not erase how they arrived (mark, never
        // delete — the root invariant). The covenant ROSTER is likewise append-only — a `party`
        // link is load-bearing for the signed identity (removing it would change what was signed),
        // so a party may not delete their own slot. Staff remain the escape hatch for genuine error.
        (resource.data.from == request.auth.uid
          && resource.data.get('rel', '') != 'invited_by'
          && resource.data.get('rel', '') != 'welcomed_by'
          && resource.data.get('rel', '') != 'party'
          && resource.data.get('rel', '') != 'collaborates_with'
          && resource.data.get('rel', '') != 'recognises'
          && resource.data.get('rel', '') != 'shares_resources_with')
        || isStaff()
        || (resource.data.get('rel', '') == 'participant' && isTreeOwner(resource.data.from))
        // grows_in: a tree carer withdraws their tree, or the keeper curates their garden.
        || (resource.data.get('rel', '') == 'grows_in'
            && (isTreeCarer(resource.data.from) || isCommunityKeeper(resource.data.to)))
        // Either community's owner/keeper circle may change only its OWN attestation. Removing one direction turns
        // reciprocal recognition back into a one-sided proposal; it never edits the other hand.
        || (resource.data.get('rel', '') in ['collaborates_with', 'recognises', 'shares_resources_with']
            && isCommunityOwner(resource.data.from))
        || (resource.data.get('rel', '') in ['rooted', 'shelters']
            && exists(/databases/$(database)/documents/lightHouses/$(resource.data.from))
            && get(/databases/$(database)/documents/lightHouses/$(resource.data.from)).data.ownerId == request.auth.uid)
        // A door-keeper (owner or steward) can decline requests and remove members.
        || (resource.data.get('rel', '') in ['member', 'join_request']
            && isCommunityKeeper(resource.data.to))
        // A keepership knock is declined by the target's keeper (community) or owner (tree).
        // (Its author withdraws it via the from == uid clause above.) NOTE: `keeper` links
        // themselves are NOT listed here — a peer cannot remove a peer; a keeper leaves only
        // by their own hand (from == uid) or by staff mend. Never keeperless: ownerId remains.
        || (resource.data.get('rel', '') == 'keeper_request'
            && (isCommunityKeeper(resource.data.to) || isTreeOwner(resource.data.to)))
        // The owner can remove a steward they appointed.
        || (resource.data.get('rel', '') == 'steward'
            && isCommunityOwner(resource.data.to)));
      allow update: if false;
    }

    // Provider credentials: third-party AI API keys. NEVER readable or writable by any
    // client — they are managed exclusively by Cloud Functions via the Admin SDK
    // (saveProviderCredential / generateClaudeContent), which bypass these rules.
    match /providerCredentials/{credId} {
      allow read, write: if false;
    }

    // Domain-verification challenges (root/INTERBEING_MATRIX.md): the single-use random
    // token binding a community to its claimed domain. Server-only — the callables return
    // the record to the keeper's hand; nothing here is for any client to read or forge.
    match /domainChallenges/{challengeId} {
      allow read, write: if false;
    }
  }
}
