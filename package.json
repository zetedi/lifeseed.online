{
  "name": "lightseed.online",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "devui": "firebase emulators:exec --only auth,firestore,storage --import ./.emulator-data --export-on-exit ./.emulator-data \"npx vite --mode emulators\"",
    "devui:seed": "node scripts/seed-emulator.mjs",
    "dev:clean": "vite --mode clean",
    "prod": "vite build --mode production",
    "prebuild": "node scripts/charter-sync.mjs && node scripts/build-initiates.mjs && node scripts/build-commits.mjs",
    "build": "vite build",
    "initiates:build": "node scripts/build-initiates.mjs",
    "commits:build": "node scripts/build-commits.mjs",
    "whitepaper:build": "node scripts/build-white-paper.mjs",
    "authority:declare": "node scripts/declare-data-authority.mjs",
    "history:consolidate": "node scripts/consolidate-code-history.mjs",
    "initiates:verify": "node scripts/verify-initiations.mjs",
    "build:clean": "vite build --mode clean",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test:living": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-lifeseed \"vitest run --config vitest.living.config.ts\"",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "check": "npm run charter:check && npm run typecheck && npm run lint && npm test",
    "seed:lightseed": "node scripts/seed-lightseed.mjs",
    "migrate:reach-privacy": "node scripts/backfill-reach-privacy.mjs",
    "context": "bash scripts/state.sh",
    "flatten": "bash scripts/flat.sh",
    "test:gemini": "node scripts/test-gemini.mjs",
    "lint": "eslint .",
    "deploy:faces": "npm run build && firebase deploy --only hosting:app && node scripts/face-og.mjs perauset && firebase deploy --only hosting:perauset && node scripts/face-og.mjs theohouse && firebase deploy --only hosting:theohouse && node scripts/face-og.mjs enlightenednations && firebase deploy --only hosting:enlightenednations && node scripts/face-og.mjs mamaway && firebase deploy --only hosting:mamaway",
    "charter": "node scripts/charter-sync.mjs",
    "charter:check": "node scripts/charter-sync.mjs --check",
    "node:create": "node scripts/create-node.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "exif-js": "^2.3.0",
    "firebase": "^12.6.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "marked": "^18.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-quill-new": "^3.8.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^14.2.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
