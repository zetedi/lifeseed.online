rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper to check if user is a staff member
    function isStaff() {
      return request.auth != null && 
        ((firestore.exists(/databases/(default)/documents/config/superadmin) &&
          firestore.get(/databases/(default)/documents/config/superadmin).data.uid == request.auth.uid) || 
         firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }

    function ownsCommunity(communityId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/communities/$(communityId)) &&
        firestore.get(/databases/(default)/documents/communities/$(communityId)).data.ownerId == request.auth.uid;
    }

    // Global rules for reading and staff writing
    match /{allPaths=**} {
      // Allow public reading of all images
      allow read: if true;
      // Allow staff to write anywhere (for administrative tasks)
      allow write: if isStaff();
    }

    // Specific rules for user-owned folders
    // The OLD name, kept: an auth uid is local to this auth provider and dies with it, but
    // everything filed here still resolves, and nothing has to move (the docs store absolute
    // download URLs, not paths). New writes go to beings/{lid} below.
    match /users/{userId}/{allPaths=**} {
      // Allow users to write to their own folder
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // FILED UNDER THE TRUE NAME (ring 2026-08-09). A lid is portable across nodes and years; a
    // uid is not, and storage is the part most likely to outlive both the auth provider and the
    // database. The credential says uid, so proving the lid costs one Firestore read — the price
    // of a name that survives. A being may write only under its OWN true name.
    match /beings/{lid}/{allPaths=**} {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.lid == lid;
    }

    // Community owners can manage their own white-label assets and event galleries
    match /communities/{communityId}/{allPaths=**} {
      allow write: if isStaff() || ownsCommunity(communityId);
    }

    // Org-collab logos — adding an org is member-wide (see firestore collabs rules), so any
    // signed-in member may upload a logo for one.
    match /collabs/{allPaths=**} {
      allow write: if request.auth != null;
    }
  }
}
